   "source": [
    "import math\n",
    "\n",
    "\n",
    "def circle_area(radius):\n",
    "    return math.pi * radius * radius\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Report:\n",
    "    def render(self):\n",
    "        return circle_area(1.0)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "def total_area(radii):\n",
    "    return sum(circle_area(r) for r in radii)\n"
   ]
  }
