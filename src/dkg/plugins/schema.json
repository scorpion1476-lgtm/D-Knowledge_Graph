{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D-Knowledge_Graph plugin manifest",
  "type": "object",
  "required": ["name", "version", "capabilities"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9\\-_.]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[+-][A-Za-z0-9.-]+)?$"
    },
    "description": {"type": "string", "maxLength": 512},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9._-]+$"}
    },
    "entrypoints": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.]*$": {"type": "string"}
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "network": {"type": "boolean"},
        "adapters": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": false
}
